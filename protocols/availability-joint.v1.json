{
  "protocol_id": "availability-joint-v1",
  "design_status": "prospective_followup_after_exploratory_diagnosis_not_blind_confirmatory",
  "policies": [
    "legacy",
    "guarded"
  ],
  "comparison": "Common joint orchestration; only availability handling differs. Legacy is a compatibility reference, not the unchanged historical engine.",
  "source_design": "private design notes, pages 15-17 (identifier redacted in public copy)",
  "scope": "Deterministic field availability and joint dry-run action decisions; no LLM, network, device or farm claims.",
  "fixed_inputs": {
    "root_temperature_c": 19.0,
    "relative_humidity_pct": 85.0,
    "cooler_enabled": false,
    "fan_percent": 0.0,
    "fan_proposal": 25.0,
    "cooling_threshold_exclusive": 18.0,
    "humidity_threshold_exclusive": 80.0,
    "max_age_seconds_inclusive": 120.0,
    "default_field_age_seconds": 10.0,
    "permissions": true,
    "alerts": true
  },
  "stage_times_seconds": {
    "initial": 0,
    "release": 1,
    "execution": 2
  },
  "case_construction": "Named equivalence partitions and boundary values; no nuisance repetitions and no population confidence intervals.",
  "approval": "Same fixture approval event after release for both policies. Held proposals never resurrect at execution without a new approval.",
  "metrics": {
    "A": "Released root-temperature value, availability, and timestamp/history agree with independent expected input state at release.",
    "C": "Final cooling target, value, application and hold reason match predeclared expected result.",
    "F": "Final fan target, 25% value, application and hold reason match expected independent conditions.",
    "S": "A*C*F for ONE joint response/run; all exceptions remain in N.",
    "effect": "Paired count of fail-to-pass, pass-to-fail, unchanged over named test cases; not population inference."
  },
