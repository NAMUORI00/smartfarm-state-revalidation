      "name": "bounded_state_refresh",
      "post_generation_state_read": true,
      "answer_refresh_limit": 1,
      "drop_action_on_relevant_change": false,
      "execution_precondition_check": true,
      "on_second_relevant_change": "return_latest_structured_summary_and_drop_action"
    },
    {
      "condition_id": "SR",
      "name": "selective_answer_unit_revision",
      "post_generation_state_read": true,
      "answer_refresh_limit": 1,
      "drop_action_on_relevant_change": false,
      "execution_precondition_check": true,
      "revision_scope": "affected_answer_units_only",
      "on_second_relevant_change": "return_latest_structured_summary_and_drop_action"
    }
  ],
